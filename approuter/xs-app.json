{
  "welcomeFile": "/comprototypesalesorderaisalesorderui/index.html",
  "authenticationMethod": "route",
  "websockets": {
    "enabled": true
  },
  "routes": [
    {
      "source": "^(?:/comprototypesalesorderaisalesorderui)?/sales-order/(.*)$",
      "target": "/sales-order/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^(?:/comprototypesalesorderaisalesorderui)?/pico-voice$",
      "target": "/pico-voice",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
