<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <TableSelectDialog
        id="productValueHelpDialog"
        title="Select Product"
        noDataText="No products found"
        rememberSelections="false"
        search=".onProductValueHelpSearch"
        confirm=".onProductValueHelpConfirm"
        cancel=".onProductValueHelpCancel"
        items="{/Products}">
        <columns>
            <Column>
                <Text text="Product Number" />
            </Column>
            <Column>
                <Text text="Description" />
            </Column>
            <Column>
                <Text text="Product Category" />
            </Column>
        </columns>
        <items>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{productNumber}" />
                    <Text text="{name}" />
                    <Text text="{productCategoryID}" />
                </cells>
            </ColumnListItem>
        </items>
    </TableSelectDialog>
</core:FragmentDefinition>
