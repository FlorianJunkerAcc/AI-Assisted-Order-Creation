<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        id="productValueHelpDialog"
        title="Select Product"
        contentWidth="60rem"
        stretchOnPhone="true"
        draggable="true"
        resizable="true">
        <content>
            <VBox width="100%">
                <OverflowToolbar>
                    <SearchField
                        id="productFreeTextFilter"
                        width="18rem"
                        placeholder="{i18n>searchProducts}"
                        liveChange=".onProductValueHelpSearch" />
                    <Input
                        id="productNumberFilter"
                        width="11rem"
                        placeholder="{i18n>productNumber}"
                        liveChange=".onProductFilterChange" />
                    <Input
                        id="productCategoryFilter"
                        width="11rem"
                        placeholder="{i18n>productCategory}"
                        liveChange=".onProductFilterChange" />
                    <ToolbarSpacer />
                    <Button
                        icon="sap-icon://clear-filter"
                        type="Transparent"
                        tooltip="{i18n>clearFilters}"
                        press=".onClearProductFilters" />
                </OverflowToolbar>
                <Table
                    id="productTable"
                    class="productValueHelpTable"
                    mode="SingleSelectMaster"
                    growing="true"
                    growingThreshold="20"
                    noDataText="{i18n>noProductsFound}"
                    updateFinished=".onProductTableUpdateFinished"
                    items="{/Products}">
                    <columns>
                        <Column>
                            <Text text="{i18n>productNumber}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>description}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>productCategory}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>status}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            type="Active"
                            highlight="{path: 'ID', formatter: '.formatProductHighlight'}">
                            <cells>
                                <Text text="{productNumber}" />
                                <Text text="{name}" />
                                <Text text="{productCategoryID}" />
                                <ObjectStatus
                                    text="{i18n>alreadyInOrder}"
                                    state="Success"
                                    visible="{path: 'ID', formatter: '.formatIsAlreadyInOrder'}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>cancel}"
                press=".onProductValueHelpCancel" />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>select}"
                type="Emphasized"
                press=".onProductValueHelpConfirm" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
