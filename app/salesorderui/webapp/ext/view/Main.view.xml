<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:macros="sap.fe.macros" controllerName="com.prototype.salesorderai.salesorderui.ext.view.Main">
<macros:Page id="Page" title="Create Sales Order" showFooter="true">
<macros:items>
<VBox id="salesOrderContent" class="sapUiResponsiveContentPadding" width="100%">
<!--  Order Information  -->
<Panel id="orderHeaderPanel" headerText="{i18n>orderInformation}" expandable="true" expanded="true" width="100%" class="sapUiResponsiveMargin">
<content>
<l:Grid id="orderHeaderContent" defaultSpan="L4 M6 S12" hSpacing="1" vSpacing="0" width="100%">
<VBox id="customerField" width="100%">
<Label id="customerLabel" text="Customer" labelFor="customerSelect" required="true"/>
<ComboBox id="customerSelect" width="100%" placeholder="{i18n>selectCustomer}" items="{/Customers}" selectionChange=".onHeaderChange" required="true" class="sapUiSmallMarginBottom">
<core:Item id="customerSelectItem" key="{ID}" text="{= ${customerNumber} + ' | ' + ${name} + ' | ' + ${address}}"/>
</ComboBox>
</VBox>
<VBox id="statusField" width="100%">
<Label id="statusLabel" text="Status" labelFor="statusInput"/>
<ObjectStatus id="statusInput" text="Draft" state="Information" class="sapUiSmallMarginBottom"/>
</VBox>
<VBox id="salesUnitField" width="100%">
<Label id="salesUnitLabel" text="{i18n>salesUnit}" labelFor="salesUnitInput"/>
<ObjectStatus id="salesUnitInput" text="US1100 - Sales Unit US" state="Information" class="sapUiSmallMarginBottom"/>
</VBox>
</l:Grid>
</content>
</Panel>
<!--  Sales Order Items  -->
<Panel id="orderItemsPanel" expandable="true" expanded="true" width="100%" class="sapUiResponsiveMargin">
<headerToolbar>
<Toolbar id="orderItemsToolbar" class="stickyOrderItemsToolbar">
<Title id="orderItemsTitle" text="{i18n>orderItems}" level="H2"/>
<ObjectStatus id="orderItemsCount" text="{order>/itemCount} {i18n>items}" state="None" class="sapUiTinyMarginBegin"/>
<ObjectStatus id="orderItemsHeaderTotal" title="{i18n>orderTotal}" text="{order>/orderTotal} EUR" state="Information" class="sapUiSmallMarginBegin"/>
<ToolbarSpacer/>
<Button id="addProductButton" text="{i18n>addProduct}" icon="sap-icon://add" type="Transparent" press=".onAddProduct" class="addProductButton sapUiSmallMarginEnd"/>
<Button id="startAIAssistantButton" text="{i18n>aiAssistedEntry}" icon="sap-icon://ai" type="Transparent" press=".onStartAIAssistant" class="aiAssistedEntryButton"/>
<Button id="startProductRecommendationsButton" text="{i18n>aiProductRecommendations}" icon="sap-icon://ai" type="Transparent" press=".onStartProductRecommendations" class="aiAssistedEntryButton"/>
<Button id="startOrderValidationButton" text="{i18n>aiOrderValidation}" icon="sap-icon://ai" type="Transparent" press=".onStartOrderValidation" class="aiAssistedEntryButton"/>
</Toolbar>
</headerToolbar>
<content>
<VBox id="orderItemsContent" width="100%">
<!--  AI assistant area (collapsed by default)  -->
<VBox id="aiAssistantArea" width="100%" visible="false" class="aiAssistantArea sapUiMediumMarginBottom sapUiMediumMarginTop">
<Title id="aiOrderEntryTitle" text="{i18n>aiOrderEntry}" level="H3" class="sapUiSmallMarginBottom"/>
<Button id="startVoiceInputButton" text="{i18n>startVoiceInput}" icon="sap-icon://microphone" press=".onStartVoiceInput" class="sapUiSmallMarginBottom voiceStartButton"/>
<VBox id="voiceListeningIndicator" visible="false" alignItems="Center" class="sapUiMediumMargin">
<core:Icon id="voiceListeningIcon" src="sap-icon://microphone" size="2rem" color="#0070F2" class="voiceListeningPulse"/>
<Text id="voiceListeningText" text="Listening..." class="sapUiSmallMarginTop"/>
</VBox>
<Label id="aiOrderInputLabel" text="{i18n>recognizedCommand}" labelFor="aiOrderInput"/>
<TextArea id="aiOrderInput" width="100%" rows="3" value="{ui>/recognizedCommand}" liveChange=".onAIInputChange" valueLiveUpdate="true" placeholder="{i18n>voicePlaceholder}"/>
<HBox id="aiConfirmationActions" width="100%" justifyContent="End" class="sapUiSmallMarginTop">
<Button id="interpretOrderButton" text="{i18n>confirmAndAddItems}" type="Emphasized" enabled="{ui>/canSubmitAiCommand}" press=".onInterpretOrderItems"/>
</HBox>
<!--  AI clarification  -->
<VBox id="clarificationArea" visible="{clarification>/visible}" width="100%" class="sapUiMediumMarginTop">
<VBox id="clarificationBox" class="clarificationBox sapUiSmallMarginBottom">
<HBox id="clarificationHeaderBox" alignItems="Center" class="sapUiTinyMarginBottom">
<core:Icon id="clarificationIcon" src="sap-icon://ai" class="clarificationIcon sapUiTinyMarginEnd"/>
<Text id="clarificationHeaderText" text="The AI Assistant needs clarification" class="clarificationHeaderText"/>
</HBox>
<Text id="clarificationQuestionText" text="{clarification>/question}" class="clarificationQuestionText"/>
</VBox>
<FlexBox id="clarificationSuggestions" wrap="Wrap" items="{clarification>/suggestions}">
<Button id="clarificationSuggestionButton" text="{clarification>productName}" type="Default" press=".onSelectClarificationSuggestion" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
</FlexBox>
</VBox>
</VBox>
<!--  AI product recommendations (based on customer order history)  -->
<VBox id="recommendationArea" visible="{recommendation>/visible}" width="100%" class="sapUiMediumMarginTop">
<VBox id="recommendationBox" class="clarificationBox sapUiSmallMarginBottom">
<HBox id="recommendationHeaderBox" alignItems="Center" class="sapUiTinyMarginBottom">
<core:Icon id="recommendationIcon" src="sap-icon://ai" class="clarificationIcon sapUiTinyMarginEnd"/>
<Text id="recommendationHeaderText" text="{i18n>aiProductRecommendations}" class="clarificationHeaderText"/>
</HBox>
<Text id="recommendationDescription" text="{i18n>recommendationDescription}" class="clarificationQuestionText"/>
</VBox>
<FlexBox id="productRecommendations" wrap="Wrap" items="{recommendation>/recommendations}">
<VBox id="productRecommendation" width="14rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
<!-- 
    Der Button zeigt Produktname UND die empfohlene Menge
    (Mittelwert der historischen Bestellmengen) direkt an,
    damit der Nutzer vor dem Klick sieht, was übernommen wird.
 -->
<Button id="recommendedProductButton" text="{= ${recommendation>productName} + ' (Qty ' + ${recommendation>averageQuantity} + ')'}" type="Default" press=".onSelectRecommendedProduct" class="sapUiTinyMarginBottom"/>
<Text id="recommendedProductReason" text="{recommendation>reason}" wrapping="true" class="recommendationReasonText"/>
</VBox>
</FlexBox>
</VBox>
<!--  AI order validation (checks current draft against customer order history)  -->
<VBox id="validationArea" visible="{validation>/visible}" width="100%" class="sapUiMediumMarginTop">
<VBox id="validationBox" class="clarificationBox sapUiSmallMarginBottom">
<HBox id="validationHeaderBox" alignItems="Center" class="sapUiTinyMarginBottom">
<core:Icon id="validationIcon" src="sap-icon://ai" class="clarificationIcon sapUiTinyMarginEnd"/>
<Text id="validationHeaderText" text="{i18n>aiOrderValidation}" class="clarificationHeaderText"/>
</HBox>
<Text id="validationSummaryText" text="{validation>/message}" class="clarificationQuestionText"/>
</VBox>
<!-- 
    Jede Warnung referenziert explizit ihre Position im Auftrag.
    Die Liste ist rein informativ; ein Klick verändert nichts.
 -->
<VBox id="validationWarnings" items="{validation>/warnings}" width="100%">
<VBox class="validationWarningItem">
<Text text="{= 'Position ' + ${validation>position} + ' \u2014 ' + ${validation>productName}}" class="validationWarningTitle"/>
<Text text="{validation>message}" wrapping="true" class="validationWarningMessage"/>
</VBox>
</VBox>
</VBox>
<!--  Single source of truth: the order items table  -->
<Table id="orderItemsTable" width="100%" growing="true" growingThreshold="10" sticky="ColumnHeaders,HeaderToolbar" noDataText="{i18n>noProductsAdded}" items="{order>/items}">
<columns>
<Column id="positionColumn" width="8%" hAlign="Center">
<Text id="positionColumnText" text="{i18n>position}"/>
</Column>
<Column id="productColumn" width="32%">
<Text id="productColumnText" text="{i18n>product}"/>
</Column>
<Column id="quantityColumn" width="14%" hAlign="Center">
<Text id="quantityColumnText" text="{i18n>quantity}"/>
</Column>
<Column id="unitColumn" width="8%" hAlign="Center">
<Text id="unitColumnText" text="{i18n>unit}"/>
</Column>
<Column id="unitPriceColumn" width="15%" hAlign="End" demandPopin="true" minScreenWidth="Tablet">
<Text id="unitPriceColumnText" text="{i18n>unitPrice}"/>
</Column>
<Column id="totalPriceColumn" width="17%" hAlign="End" demandPopin="true" minScreenWidth="Tablet">
<Text id="totalPriceColumnText" text="{i18n>totalPrice}"/>
</Column>
<Column id="actionsColumn" width="6%" hAlign="End">
<Text id="actionsColumnText" text=""/>
</Column>
</columns>
<items>
<ColumnListItem id="orderItemTemplate">
<cells>
<Text id="positionText" text="{order>position}"/>
<HBox id="productSelect" width="100%" alignItems="Center">
<Input id="productSelectInput" width="100%" value="{order>productName}" placeholder="{i18n>selectProduct}" editable="false" class="productDisplayField"/>
<Button id="productValueHelpButton" icon="sap-icon://value-help" type="Transparent" tooltip="Select Product" press=".onProductValueHelpRequest"/>
</HBox>
<StepInput id="quantityInput" value="{order>quantity}" min="1" step="1" width="100%" change=".onQuantityChange"/>
<Text id="unitText" text="{order>unit}"/>
<ObjectNumber id="unitPriceText" number="{order>unitPrice}" unit="EUR"/>
<ObjectNumber id="totalPriceText" number="{order>totalPrice}" unit="EUR" emphasized="true"/>
<Button id="deleteOrderItemButton" icon="sap-icon://delete" type="Transparent" tooltip="Remove item" press=".onDeleteProduct"/>
</cells>
</ColumnListItem>
</items>
</Table>
</VBox>
</content>
</Panel>
</VBox>
</macros:items>
<!--  Page Footer: always pinned to the bottom of the viewport,
     shows item count, order total and the primary Create Order action.
     Reinforced via CSS (see style.css) to remain visible on iPad.  -->
<macros:footer>
<OverflowToolbar id="footerToolbar" class="stickyPageFooter">
<ObjectStatus id="footerItemCount" text="{order>/itemCount} {i18n>items}" state="None"/>
<ObjectStatus id="footerOrderTotal" title="{i18n>orderTotal}" text="{order>/orderTotal} EUR" state="Information" class="sapUiSmallMarginBegin"/>
<ToolbarSpacer id="footerSpacer"/>
<Button id="createOrderButton" text="{i18n>createOrder}" type="Emphasized" enabled="{order>/canCreate}" press=".onCreateOrder"/>
</OverflowToolbar>
</macros:footer>
</macros:Page>
</mvc:View>