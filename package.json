{
  "name": "prototype_salesorderApp_ai",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-ai-sdk/orchestration": "^2.16.0",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-salesorderui": "cds watch --open com.prototype.salesorderai.salesorderui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy prototype_salesorderApp_ai --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "SalesCloud": {
        "kind": "odata-v2",
        "model": "srv/external/sales-cloud",
        "credentials": {
          "destination": "SAP_Sales_Cloud_V1"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/salesorderui"
  ]
}
